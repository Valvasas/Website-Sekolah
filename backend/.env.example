# SERVER
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001

# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

SESSION_SECRET=
# auto = Secure hanya saat request HTTPS. Gunakan true setelah domain HTTPS aktif.
COOKIE_SECURE=auto

# DATABASE
DB_PATH=./data/smkn1terisi

# Untuk uji coba server lokal sekolah, isi dengan alamat yang dipakai client.
# Contoh: http://192.168.1.10:3001,http://localhost:3001
ALLOWED_ORIGINS=https://smkn1terisi.sch.id,https://www.smkn1terisi.sch.id
ALLOWED_ORIGIN_SUFFIXES=

# GOOGLE OAUTH2 (opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# false = Google hanya menautkan akun yang emailnya sudah terdaftar.
GOOGLE_AUTO_PROVISION=false

# EMAIL (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_TLS_REJECT_UNAUTHORIZED=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# SMS OTP (opsional, Twilio)
# Jika kosong, UI otomatis hanya menawarkan verifikasi email.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

FRONTEND_URL=http://localhost:3001

# RATE LIMITING
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
API_MAX_REQUESTS_PER_MINUTE=300
RESET_TOKEN_EXPIRY=15
REGISTER_MAX_PER_HOUR=5
OTP_VERIFY_MAX_PER_15_MIN=10
OTP_RESEND_MAX_PER_HOUR=5
