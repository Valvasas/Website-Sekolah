# ============================================================
# SMKN 1 TERISI — ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke git!
# ============================================================

# SERVER
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001

# FIX: JWT_SECRET WAJIB diisi — server akan CRASH jika kosong di production
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=WAJIB_DIISI_GENERATE_DENGAN_PERINTAH_DI_ATAS
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

SESSION_SECRET=WAJIB_DIISI_JUGA_STRING_RANDOM_PANJANG

# DATABASE
DB_PATH=./data/smkn1terisi

# FIX: CORS — di production isi dengan domain sekolah yang spesifik
# Pisahkan dengan koma jika ada lebih dari satu domain
# Development: biarkan kosong (localhost otomatis diizinkan)
ALLOWED_ORIGINS=https://smkn1terisi.sch.id,https://www.smkn1terisi.sch.id
# Untuk testing tunnel random seperti Cloudflare Tunnel: trycloudflare.com
# Jangan isi wildcard "*" karena API memakai credentials/JWT.
ALLOWED_ORIGIN_SUFFIXES=

# GOOGLE OAUTH2 (opsional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# EMAIL (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=emailsekolah@gmail.com
EMAIL_PASS=app_password_gmail_disini
EMAIL_FROM="SMK Negeri 1 Terisi <emailsekolah@gmail.com>"

# FRONTEND URL (legacy, sekarang pakai ALLOWED_ORIGINS)
FRONTEND_URL=http://localhost:3001

# RATE LIMITING
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
RESET_TOKEN_EXPIRY=15
