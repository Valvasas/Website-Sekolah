# ============================================
# SMKN 1 TERISI — ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke git!
# ============================================

# SERVER
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001

# JWT SECRET — ganti dengan string random panjang
JWT_SECRET=smkn1terisi_super_secret_jwt_key_ganti_ini_2024
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# SESSION SECRET
SESSION_SECRET=smkn1terisi_session_secret_ganti_ini

# DATABASE (SQLite — file lokal, cocok untuk development)
DB_PATH=./data/smkn1terisi.db

# GOOGLE OAUTH2 — isi dari Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# EMAIL (Nodemailer — untuk lupa password & notifikasi)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=emailsekolah@gmail.com
EMAIL_PASS=app_password_gmail_disini
EMAIL_FROM="SMK Negeri 1 Terisi <emailsekolah@gmail.com>"

# TWILIO (opsional — untuk OTP via WhatsApp/SMS)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE=+1234567890

# FRONTEND URL (untuk CORS)
FRONTEND_URL=http://localhost:3001

# RATE LIMITING
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# PASSWORD RESET TOKEN EXPIRY (dalam menit)
RESET_TOKEN_EXPIRY=15
