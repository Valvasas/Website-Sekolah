# SERVER
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001

# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

SESSION_SECRET=

# DATABASE
DB_PATH=./data/smkn1terisi

ALLOWED_ORIGINS=https://smkn1terisi.sch.id,https://www.smkn1terisi.sch.id
ALLOWED_ORIGIN_SUFFIXES=

# GOOGLE OAUTH2 (opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# EMAIL (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

FRONTEND_URL=http://localhost:3001

# RATE LIMITING
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
RESET_TOKEN_EXPIRY=15
